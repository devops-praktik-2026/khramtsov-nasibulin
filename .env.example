# Образец файла настроек. Скопируйте его в .env и правьте под себя:
#     cp .env.example .env
#
# Сам .env в репозиторий не попадает — он перечислен в .gitignore.
# Это первое правило работы с паролями: образец в репозитории, значения рядом.

# --- сервис клиентов ---
# По умолчанию используется файл рядом с проектом, чтобы всё запускалось
# без Docker. В контейнерах вместо этого подставляется адрес PostgreSQL.
DATABASE_URL=sqlite:///./accounts.db

# --- сервис заказов ---
ACCOUNTS_URL=http://localhost:8001
ACCOUNTS_TIMEOUT_SECONDS=2.0

# --- учебный стенд, занятие 7 ---
# OpenTofu и Compose хранилища читают окружение терминала.
# Сам OpenTofu этот .env не загружает: экспортируйте значения перед запуском.
# Пароль существующей базы при миграции state оставьте прежним.
TF_VAR_db_password=
AWS_ACCESS_KEY_ID=praktikum
AWS_SECRET_ACCESS_KEY=

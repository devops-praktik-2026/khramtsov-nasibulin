# Окружение и временные файлы
.venv/
.venv-ansible/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Локальная база данных
*.db
*.sqlite3

# Настройки с паролями — в репозиторий не попадают никогда.
# Образец без секретов лежит в .env.example
.env
.env.*
!.env.example

# Состояние инфраструктуры. Там адреса, идентификаторы и иногда пароли.
# На занятии 5 разберём, почему этот файл нельзя хранить рядом с кодом.
*.tfstate
*.tfstate.*
.terraform/
crash.log
*.tfplan
*.tfvars
*.tfvars.json
!*.tfvars.example
.local/

# Ключи доступа
*.pem
*.key
id_rsa*
id_ed25519*
*.local.yml
*.local.hcl
*.tfbackend

# Редакторы
.idea/
.vscode/
.DS_Store

infra/ansible/inventory.ini
infra/ansible/vars.local.yml
